{
  "name": "ROS2 Humble Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/root/workspace",
  "mounts": [
    "source=${localWorkspaceFolder},target=/root/workspace,type=bind"
  ],
  "runArgs": [
    "--gpus=all",// works on WSL2 (NVIDIA) and Linux
    "-v", "${env:SSH_AUTH_SOCK}:/ssh-agent",
    "-e", "SSH_AUTH_SOCK=/ssh-agent"
  ],
  "containerEnv": {
    "QT_X11_NO_MITSHM": "1",
    "DISPLAY": "${localEnv:DISPLAY}",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "remoteUser": "root",
  "forwardPorts": [5000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "twxs.cmake",
        "ms-vscode.cpptools",
        "ms-python.vscode-pylance",
        "astral-sh.ruff"
      ]
    }
  }
}
