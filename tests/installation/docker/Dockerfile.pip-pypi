# Test: pip install ros-mcp from PyPI
# This Dockerfile verifies that the documented pip installation method works.
#
# Usage: docker build -f tests/installation/docker/Dockerfile.pip-pypi .

FROM python:3.10-slim

# Upgrade pip to latest
RUN pip install --upgrade pip

# Install ros-mcp from PyPI (as documented)
RUN pip install ros-mcp

# Verify the installation works
RUN ros-mcp --help

# Verify the package is importable
RUN python -c "import ros_mcp; print(f'ros-mcp version: {ros_mcp.__version__ if hasattr(ros_mcp, \"__version__\") else \"installed\"}')"

# Final success message
RUN echo "SUCCESS: pip install ros-mcp from PyPI works correctly"
